{
    // Base Infection configuration for it-pack packages.
    // Seed from src/RunIt/infection.json5 (Codeception adapter, MSI ratchet).
    // Copy to a package's infection.json5 and tune `minMsi` / `minCoveredMsi`
    // once a baseline is recorded. Shared via docs/CONSOLIDATION_PLAN.md (Phase 0).
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.33.3/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "threads": "max",
    "timeout": 60,
    "testFramework": "codeception",
    "testFrameworkExtraArgs": "Unit",
    "mutators": {
        "@default": true
    },
    // MSI floors are the ratchet gate. They start at 0 so the first CI run can
    // capture the baseline without failing; replace with (baseline - ~5) later.
    "minMsi": 0,
    "minCoveredMsi": 0,
    "logs": {
        "text": "var/infection.log",
        "summary": "var/infection.summary.json"
    }
}
