{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.33.3/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "testFramework": "codeception",
    "testFrameworkExtraArgs": "Unit",
    // Parallel per-mutant Codeception processes hang in this setup (every
    // mutant exceeds the timeout under threads >= 2, while serial runs are
    // clean), so mutation testing is pinned to a single thread.
    "threads": 1,
    "timeout": 120,
    "logs": {
        "text": "var/infection.log"
    }
}
