includes:
    - tools/phpstan/asyncit-rules/extension.neon

parameters:
    tmpDir: var/cache/phpstan
    level: max
    paths:
        - ./src
        - ./tests/Unit
        - ./tests/Conformance
        - ./tools/phpstan/asyncit-rules/src
    parallel:
        maximumNumberOfProcesses: 1
    reportUnmatchedIgnoredErrors: false

    scanFiles:
        - tools/phpstan/extensions.stub.php

    ignoreErrors:
        # RuntimeAssemblerInterface::create() is a static factory called via
        # the concrete AsyncRuntimeFactory::create() — shipmonk.deadMethod
        # cannot track static calls through interface contracts.
        - { message: '#^Unused .+RuntimeAssemblerInterface::create$#', path: src/SDK/Factory/RuntimeAssemblerInterface.php }
