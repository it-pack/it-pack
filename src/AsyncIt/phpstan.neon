includes:
    - tools/phpstan/asyncit-rules/extension.neon

parameters:
    tmpDir: var/cache/phpstan
    level: max
    paths:
        - ./src
        - ./tests/Unit
        - ./tests/Conformance
        - ./tools/phpstan/asyncit-rules/src
    parallel:
        maximumNumberOfProcesses: 1
    reportUnmatchedIgnoredErrors: false

    scanFiles:
        - tools/phpstan/extensions.stub.php

    ignoreErrors:
        # RuntimeAssemblerInterface::create() is a static factory called via
        # the concrete AsyncRuntimeFactory::create() — shipmonk.deadMethod
        # cannot track static calls through interface contracts.
        - { message: '#^Unused .+RuntimeAssemblerInterface::create$#', path: src/SDK/Factory/RuntimeAssemblerInterface.php }
        # TaskGroupInterface public API methods consumed through the contract —
        # shipmonk.deadMethod cannot track usage across interface boundaries.
        - { message: '#^Unused .+TaskGroupInterface::(await|failure|backpressurePolicy)$#', path: src/Contract/TaskGroupInterface.php }
        - { message: '#^Unused .+TaskGroup::(failure|fail|await|backpressurePolicy|close|go)$#', path: src/Domain/TaskGroup.php }
        # SchedulerEventListenerInterface consumed by adapter conformance only.
        - { message: '#^Unused .+SchedulerEventListenerInterface::onEvent$#', path: src/Contract/SchedulerEventListenerInterface.php }
        # SchedulerEvent value-object constructors consumed by factory methods.
        - { message: '#^Unused .+SchedulerEvent::__construct$#', path: src/Domain/SchedulerEvent.php }
        # SchedulerEvent value-object constructors consumed by factory methods.
        - { message: '#^Unused .+SchedulerEvent::__construct$#', path: src/Contract/SchedulerEvent.php }
        # SchedulerEvent factory methods / properties are consumed via SchedulerEventListenerInterface.
        - { message: '#^Unused .+SchedulerEvent::(spawned|resumed|suspended|completed|cancellationObserved)$#', path: src/Contract/SchedulerEvent.php }
        - { message: '#^Property .+SchedulerEvent::(\$task|\$status|\$awaitPoint) is never read$#', path: src/Contract/SchedulerEvent.php }
        # AwaitPoint enum cases are used by SchedulerEvent::suspended and future adapter wiring.
        - { message: '#^Unused .+AwaitPoint::(Readable|Writable|Delay|Channel|Join)$#', path: src/Contract/Port/AwaitPoint.php }
        # CancellationReason enum cases are used by cancellation observers and future conformance.
        - { message: '#^Unused .+CancellationReason::(DeadlineExceeded|ParentCancelled|ResourceQuotaExceeded|SystemShutdown)$#', path: src/Contract/Port/CancellationReason.php }
        # CancellationException::reason() accessor consumed by cancellation observers.
        - { message: '#^Unused .+CancellationException::reason$#', path: src/Domain/Exception/CancellationException.php }
        # TaskBehavior::$status write is performed via the property hook in TaskBehavior.php.
        - { message: '#^Property .+TaskBehavior::\$status is never written$#', path: src/Domain/Behavior/TaskBehavior.php }
        # Resilience: circuit breaker failureTimeout and rate limiter methods are for future adapter wiring.
        - { message: '#^Property .+CircuitBreaker::\$failureTimeout is never read$#', path: src/Domain/CircuitBreaker.php }
        - { message: '#^Unused .+RateLimiter::(waitForPermit|consume)$#', path: src/Domain/RateLimiter.php }
        - { message: '#^Unused .+BulkheadFullException::capacity$#', path: src/Domain/Exception/BulkheadFullException.php }
