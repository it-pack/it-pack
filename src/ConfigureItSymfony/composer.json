{
    "name": "it-pack/configure-it-symfony",
    "description": "Symfony integration for ConfigureIt — a bundle + DI extension that wires the ConfigurationBuilder and exposes the resolved snapshot as a service.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "symfony/dependency-injection": "^7.0",
        "symfony/config": "^7.0",
        "symfony/http-kernel": "^7.0",
        "it-pack/configure-it": "*@dev"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.3",
        "codeception/module-phpbrowser": "^4.1",
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0",
        "just-bases/php-obs-dev-base": "^0.1.0",
        "infection/codeception-adapter": "^0.4",
        "symfony/yaml": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\ConfigureItSymfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\ConfigureItSymfony\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "dantleech/what-changed": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse",
        "mutation": "vendor/bin/infection --configuration=infection.json5 --min-msi=80 --no-interaction",
        "security:audit": "@composer audit",
        "quality": [
            "@cs:check",
            "@analyse",
            "@test",
            "@mutation",
            "@security:audit"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ConfigureIt"
        }
    ]
}
