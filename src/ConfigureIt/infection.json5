{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.33.3/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "threads": "max",
    "timeout": 60,
    "testFramework": "codeception",
    // Codeception stays the only test framework; the adapter translates Infection's
    // PHPUnit-shaped invocations into `codecept run Unit …` (mirrors RunIt's setup).
    "testFrameworkExtraArgs": "Unit",
    "mutators": {
        "@default": true
    },
    // MSI floors are intentionally provisional (0) until a baseline is captured in CI.
    // Known local constraint (same as documented on RunIt): under this environment's
    // pcov setup the adapter runs the full Unit suite per mutant — covering-test
    // selection does not narrow — so mutants can time out and a clean MSI cannot be
    // measured locally. Once CI reports the baseline, set these to
    // (baseline - small epsilon). See docs/REVIEW.md NV19 / REFACTORING_PLAN M2.
    "minMsi": 0,
    "minCoveredMsi": 0,
    "logs": {
        "text": "var/infection.log",
        "summary": "var/infection.summary.json"
    }
}
