parameters:
    tmpDir: var/cache/phpstan
    level: 9
    paths:
        - ./src
        - ./tests/Unit
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: true

    shipmonkDeadCode:
        usageExcluders:
            usageOverMixed:
                enabled: true

    # Interface methods mandated by the ports & adapters architecture (AGENTS.md / PORTS.md).
    # shipmonk's dead-code analysis cannot trace consumption of interface
    # declarations through polymorphic calls and the Codeception verify() bridge,
    # so their concrete implementations (used in src + tests) are flagged as dead.
    # These are false positives, not defects — kept narrow and explicit.
    ignoreErrors:
        - identifier: shipmonk.deadMethod
          message: '#ItPack\\ConfigureIt\\Contract\\ValueObject\\ConfigurationPipelineInterface::run#'
        - identifier: shipmonk.deadMethod
          message: '#ItPack\\ConfigureIt\\Contract\\ValueObject\\ConfigurationSnapshotInterface::(has|get|all)#'
        - identifier: shipmonk.deadMethod
          message: '#ItPack\\ConfigureIt\\Contract\\ValueObject\\ResolutionReporterInterface::(record|occurrences)#'
