parameters:
    tmpDir: var/cache/phpstan
    level: 9
    paths:
        - ./src
        - ./tests/Unit
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: true

    shipmonkDeadCode:
        usageExcluders:
            usageOverMixed:
                enabled: true

    # Ports & adapters API surface: interfaces and their adapter implementations declare
    # methods (normalization, validation, factory `create`/`build`, reporting) that are
    # consumed polymorphically through the factory ports and the Codeception `verify()`
    # bridge. The ShipMonk dead-code detector cannot trace those usages and flags them as
    # dead. These are documented false positives, not defects. The 3 narrower patterns
    # that previously lived here were namespaced under `Contract\ValueObject\`, which does
    # not exist, so they never matched — replaced by a single package-scoped pattern.
    ignoreErrors:
        - identifier: shipmonk.deadMethod
          message: '#Unused ItPack\\ConfigureIt\\#'

