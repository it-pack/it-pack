{
    "name": "it-pack/configure-it",
    "description": "a framework-agnostic configuration SDK and resolution engine for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\ConfigureIt\\": "src/"
        }
    },
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0",
        "nette/schema": "^1.3",
        "vlucas/phpdotenv": "^5.6",
        "internal/toml": "^1.1",
        "webuni/front-matter": "^2.1",
        "aura/di": "^5.0",
        "infection/codeception-adapter": "^0.4"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dantleech/what-changed": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test:unit": "vendor/bin/codecept run Unit",
        "test:integration": "vendor/bin/codecept run Integration",
        "coverage": "vendor/bin/codecept run Unit,Integration --coverage --coverage-xml --coverage-html",
        "coverage:check": "php scripts/coverage_check.php",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "lint:length": "vendor/bin/phpcs --standard=phpcs.xml.dist src",
        "lint:magic": "vendor/bin/phpmnd src --ignore-numbers=2,100,200,300",
        "architecture": "vendor/bin/deptrac analyse",
        "analyse": "vendor/bin/phpstan analyse",
        "mutation": "vendor/bin/infection --configuration=infection.json5 --only-covering-test-cases --no-interaction",
        "mutation:changed": "vendor/bin/infection --configuration=infection.json5 --git-diff-lines --ignore-msi-with-no-mutations --only-covering-test-cases --no-interaction"
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
