{
    "name": "it-pack/configure-it-explorer",
    "description": "Read-only web explorer + graph query API over ConfigureIt resolved configuration (explain, diff, graph, provenance queries).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "configuration",
        "explorer",
        "provenance",
        "graph",
        "diagnostics"
    ],
    "require": {
        "php": "^8.3",
        "it-pack/configure-it": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\ConfigureItExplorer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\ConfigureItExplorer\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../ConfigureIt",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
