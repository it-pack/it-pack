{
    "name": "it-pack/configure-it-explorer",
    "description": "Read-only web explorer + graph query API over ConfigureIt resolved configuration (explain, diff, graph, provenance queries).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "configuration",
        "explorer",
        "provenance",
        "graph",
        "diagnostics"
    ],
    "require": {
        "php": "^8.3",
        "it-pack/configure-it": "*"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.3",
        "codeception/module-phpbrowser": "^4.1",
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\ConfigureItExplorer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\ConfigureItExplorer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../ConfigureIt",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "dantleech/what-changed": true,
            "tbachert/spi": false
        }
    }
}
