  "cards": [
    { "dot": "violet", "title": "Detection pipeline", "items": [
      "Scans string + (hinted) numeric literals via the nikic AST, recording class/method/line/role.",
      "Drops exception messages, sprintf/printf formats, enum backing values, and non-identifier prose.",
      "Numeric candidates need a naming hint (var/prop name, array key, // unit comment) and exclude trivial 0/1/0.0/1.0.",
      "Survivors are grouped by value — repetition across sites signals a shared constant."
    ] },
    { "dot": "emerald", "title": "Placement & rewrite", "items": [
      "CompositeConstantPlacementStrategy picks SameClass vs PerClass automatically.",
      "LineBasedRewriter inserts `private const` after the opening brace and replaces each literal with self::CONST strictly per recorded line.",
      "Untouched lines stay byte-for-byte identical; formatting is preserved by convention.",
      "Numeric literals become typed `private const int/float` preserving the raw token (0x1F stays 0x1F)."
    ] },
    { "dot": "amber", "title": "SemConv", "items": [
      "Collects the same constants from across the scanned tree into one dependency-free registry.",
      "Each class's local const is aliased to `SemConv::X`; existing self::X call sites are unchanged.",
      "A name collision with a differing value is a hard error, never a silent override."
    ] },
    { "dot": "rose", "title": "Trust & safety", "items": [
      "Hard rule: analyzed source is never required, included, autoloaded, or executed.",
      "The parse-result cache is a bounded content-keyed store, not a WeakMap.",
      "The OpenTelemetry recorder is an optional adapter; the library never configures global providers."
    ] }
  ]
