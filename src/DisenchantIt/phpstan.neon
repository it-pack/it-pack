parameters:
    phpVersion: 80400
    level: 9
    paths:
        - src
        - tests

    # Codeception auto-generates these support classes (actors + their trait
    # actions); they are not first-party code and fail strict analysis, so
    # exclude them from the scan. The generated trees live under both the
    # underscore (`tests/_support`) and capitalised (`tests/Support`) paths.
    excludePaths:
        - tests/_support
        - tests/Support

    # Extensions
    scanDirectories:
        - vendor

    # Type coverage
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
