parameters:
    phpVersion: 80400
    level: 9
    paths:
        - src
        - tests

    # Codeception auto-generates these support classes; they are not first-party
    # code and fail strict analysis, so exclude them from the scan.
    excludePaths:
        - tests/Support/_generated

    # Extensions
    scanDirectories:
        - vendor

    # Type coverage
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
