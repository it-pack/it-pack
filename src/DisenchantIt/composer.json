{
    "name": "it-pack/disenchant-it",
    "description": "A library and SDK to find and replace magic scalar values in PHP. Finds and replaces magic scalar values in PHP code with constants or enums.",
    "type": "library",
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "nette/php-generator": "^4.2",
        "nikic/php-parser": "^5.8",
        "rector/rector": "^2.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.1",
        "codeception/module-asserts": "^3.0",
        "codeception/module-phpbrowser": "^3.0",
        "consolidation/robo": "^3.0",
        "fivefilters/readability.php": "^3.3",
        "infection/codeception-adapter": "^0.4.7",
        "just-bases/php-obs-dev-base": "^0.1.0",
        "just-bases/php-qa-base": "^1.0",
        "just-bases/php-unit-test-base": "^1.0",
        "open-telemetry/api": "^1.0",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "open-telemetry/sem-conv": "^1.0",
        "phparkitect/phparkitect": "^1.2"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "ItPack\\DisenchantIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\DisenchantIt\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": false,
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": false,
            "infection/extension-installer": true,
            "dantleech/what-changed": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit",
        "test:integration": "vendor/bin/codecept run Integration",
        "test:acceptance": "vendor/bin/codecept run Acceptance",
        "test:coverage": "vendor/bin/codecept run --coverage --coverage-html",
        "analyse": "vendor/bin/phpstan analyse",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "architecture": "vendor/bin/phparkitect check",
        "mutation": "vendor/bin/infection --min-msi=80",
        "mutation:ci": "vendor/bin/infection --min-msi=0 --no-interaction",
        "rector": "vendor/bin/rector",
        "refactor": "@rector process",
        "refactor:dry": "@rector process --dry-run",
        "security:audit": "@composer audit",
        "quality": [
            "@cs:check",
            "@analyse",
            "@architecture",
            "@test",
            "@mutation",
            "@security:audit"
        ]
    }
}
