{
    "name": "it-pack/configure-it-testing",
    "description": "Testing utilities for ConfigureIt consumers: fakes (source, loader, processor, in-memory graph, node factory) and a ConfigurationAssertions trait.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "configuration",
        "testing",
        "fakes",
        "fixtures",
        "assertions",
        "phpunit"
    ],
    "require": {
        "php": "^8.3",
        "it-pack/configure-it": "*",
        "nette/schema": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\ConfigureItTesting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\ConfigureItTesting\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../ConfigureIt",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
