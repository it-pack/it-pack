{
    "source": "src",
    "logs": [
        {
            "type": "coverage-xml",
            "path": "coverage-xml"
        },
        {
            "type": "html",
            "path": "coverage-html"
        }
    ],
    "minMsi": 80,
    "minMsiWithCoverage": 80,
    "mutators": {
        "@default": true
    },
    "phpunit": {
        "configFile": "codeception.yml",
        "testFramework": "codeception",
        "testFrameworkExtraArgs": ["Unit"]
    }
}
