  "cards": [
    { "dot": "cyan", "title": "Facade & incremental state", "items": [ "Hasher is the public orchestrator: hash / hashFile / hashStream / hashFiles / hashDirectory / hashInput / verify.", "HashBuilder is immutable copy-on-write: each append() copies the HashContext and returns a new builder.", "Hash is a constant-time-comparable value object (hash_equals, toUrn: urn:hashit:<algo>:<hex>)." ] },
    { "dot": "emerald", "title": "Algorithm catalogue", "items": [ "HashAlgorithm enum enumerates every PHP hash_algos() id, normalised to SCREAMING_SNAKE_CASE.", "#[AlgorithmMetadata] carries output/block bits + collision status (Recommended / Legacy / Weak / Broken).", "#[HmacSafe] gates hash_hmac(); supports(), resolve(), recommendedAlgorithms() and brokenAlgorithms() derive from attributes." ] },
    { "dot": "violet", "title": "Input & tree framing", "items": [ "HashInput (String / File / Stream / Composite) exposes writeTo(HashSink) with 8-byte LE length framing (NF-B3).", "CompositeInput frames children recursively so order/boundaries are canonical.", "TreeHasher hashes chunks then THEX-style combines leaves: node = H(frame(L)||frame(R)); a single chunk equals hash()." ] },
    { "dot": "amber", "title": "Keyed hashing & KDF", "items": [ "KeyedHasher performs HMAC; Hkdf (RFC 5869) is built only on the keyed hasher, so derivations stay observable.", "PBKDF2 (hash_pbkdf2) and Argon2id (password_hash/verify) are Native adapters behind ports.", "TreeHasher, Hkdf and ManifestVerifier live in core and depend on nothing but the Contract." ] },
    { "dot": "rose", "title": "Trust & observability boundaries", "items": [ "Core crosses a walled boundary only at NativeHashIt (composition root) into ext-hash / ext-password.", "OpenTelemetry (API-only) and CNCF CloudEvents (via PSR-18) observers emit to host-owned sinks; both are optional suggested deps.", "Format is a deliberately walled namespace for manifest (de)serialization, isolated from core hashing logic." ] }
  ]
