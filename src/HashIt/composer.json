{
    "name": "it-pack/hash-it",
    "description": "Hashes strings, files and streams via PHP's hash extension behind a small hexagonal (ports & adapters) API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-hash": "*"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\HashIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "suggest": {
        "psr/http-message": "Install to hash PSR-7 streams via ItPack\\HashIt\\Adapter\\PsrStreamHasher"
    },
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "require-dev": {
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0",
        "just-bases/php-obs-dev-base": "^0.1.0",
        "infection/codeception-adapter": "^0.4",
        "phparkitect/phparkitect": "^1.2",
        "symfony/http-client": "^8.1",
        "nyholm/psr7": "^1.8",
        "psr/http-message": "^2.0",
        "cloudevents/sdk-php": "^1.2",
        "open-telemetry/api": "^1.10"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dantleech/what-changed": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "cs:strict": "bash bin/strict-gates.sh",
        "analyse": "vendor/bin/phpstan analyse",
        "architecture": "vendor/bin/phparkitect check",
        "mutation": "vendor/bin/infection --min-msi=73 --no-interaction",
        "security:audit": "@composer audit",
        "quality": [
            "@cs:check",
            "@analyse",
            "@architecture",
            "@test:unit",
            "@mutation",
            "@security:audit"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
