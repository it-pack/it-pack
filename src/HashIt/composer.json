{
    "name": "it-pack/hash-it",
    "description": "Hashes strings, files and streams via PHP's hash extension behind a small hexagonal (ports & adapters) API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-hash": "*"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\HashIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "suggest": {
        "psr/http-message": "Install to hash PSR-7 streams via ItPack\\HashIt\\Adapter\\PsrStreamHasher"
    },
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "require-dev": {
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0",
        "just-bases/php-obs-dev-base": "^0.1.0",
        "symfony/http-client": "^8.1",
        "nyholm/psr7": "^1.8",
        "psr/http-message": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dantleech/what-changed": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "test:unit": "vendor/bin/codecept run Unit",
        "coverage": "vendor/bin/codecept run Unit --coverage --coverage-xml --coverage-html",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse",
        "architecture": "vendor/bin/deptrac --config-file=deptrac.yaml"
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
