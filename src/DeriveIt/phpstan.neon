parameters:
    tmpDir: var/cache/phpstan
    level: 5
    paths:
        - ./src
        - ./tests/Functional
        - ./tests/Unit
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        -
            identifier: method.unused
            path: tests/**
        -
            identifier: shipmonk.deadMethod
            path: tests/**
        # Contract interfaces are the public API surface; their methods are not
        # invoked through the interface type within this package, so the
        # dead-method detector would otherwise flag them as unused.
        -
            identifier: shipmonk.deadMethod
            path: src/Contract/**
        # The public DeriveIt facade exposes helper entry points (e.g.
        # deriveTraitInterfaces) that are not consumed within the package.
        -
            identifier: shipmonk.deadMethod
            path: src/DeriveIt.php
        # DerivationResult is a public value object: its fields (methods,
        # substitutions, constants) are read by consumers of the library, not
        # internally, so the dead-property detector would otherwise flag them.
        -
            identifier: shipmonk.deadProperty.neverRead
            path: src/Generator/DerivationResult.php
        # The telemetry vocabulary in Contract/Telemetry is a shared contract:
        # UNIT_MILLISECONDS / UNIT_PERCENT are consumed by the sibling bridge
        # package (DeriveItRunit), which is out of this package's analysis scope,
        # so the dead-constant detector would otherwise flag them.
        -
            identifier: shipmonk.deadConstant
            message: '#\bUNIT_MILLISECONDS\b|\bUNIT_PERCENT\b#'
            path: src/Contract/Telemetry/DeriveUnits.php

