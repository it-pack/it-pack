{
    "name": "it-pack/derive-it",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "nette/php-generator": "^4.2",
        "psr/cache": "^1.0 || ^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\DeriveIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "_Fixture\\": "fixtures/",
            "_Vendor\\": "fixtures/"
        }
    },
    "bin": [
        "bin/derive"
    ],
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "require-dev": {
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0",
        "codeception/module-asserts": "*",
        "infection/codeception-adapter": "^0.4.7"
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "infection/extension-installer": true,
            "dantleech/what-changed": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test:unit": "vendor/bin/codecept run Unit",
        "coverage": "vendor/bin/codecept run Unit --coverage --coverage-xml --coverage-html",
        "coverage:check": "vendor/bin/codecept run Unit --coverage-xml --coverage-html && php scripts/coverage_report.php --min=96",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "cs:lines": "vendor/bin/phpcs --standard=phpcs.xml.dist src tests",
        "analyse": "vendor/bin/phpstan analyse",
        "architecture": "vendor/bin/deptrac",
        "infection": "vendor/bin/infection --min-msi=80"
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    }
}
