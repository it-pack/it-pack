  "cards": [
    {
      "dot": "cyan",
      "title": "Entry & composition",
      "items": [
        "DeriveIt is a thin, stateless static facade over the public API.",
        "DeriveItFactory is the composition root: wires the 4 derivers behind interfaces and shares one ReflectionCache + one Nette Factory.",
        "CLI: bin/derive → DeriveCommand → ArgParser → FileTargetResolver."
      ]
    },
    {
      "dot": "emerald",
      "title": "Derivers & graph walk",
      "items": [
        "InterfaceDeriver (flat + per-trait), FamilyDeriver (cross-reference rewrite), AdapterGenerator (delegating adapter).",
        "RecursiveClass / Interface / TraitResolver walk the parent, trait, and interface graph (getClassesRecursively / getTraitsRecursively).",
        "Flat mode uses ReflectionClass::getMethods(IS_PUBLIC) on the concrete class; per-trait mode walks traits recursively."
      ]
    },
    {
      "dot": "violet",
      "title": "Reflection & cache",
      "items": [
        "ClassReflection is a facade over the PHP Reflection API.",
        "Three swappable caches implement ReflectionCacheInterface: InMemory, Weak, PsrCache (psr/cache).",
        "Reflection is memoized per run so each type is reflected at most once."
      ]
    },
    {
      "dot": "amber",
      "title": "Signature & substitution",
      "items": [
        "MethodExtractor applies visibility / static / magic / constructor filters.",
        "MethodSignatureFactory reuses Nette Factory::fromMethodReflection as the single typing source of truth.",
        "TypeSubstitutor rewrites self/static/parent plus typeSubstitutionMap + namespacePrefixMap; Naming handles collisions and adapter short names."
      ]
    },
    {
      "dot": "rose",
      "title": "Self-containment & config",
      "items": [
        "LeakageAuditor (opt-in auditLeakage) scans every return/param FQCN for non-port types.",
        "assertSelfContained forbids extends of any non-owned interface; reExposeOwnedInterfaces is the only allow-list.",
        "DeriveConfig presets strict() / forAdapter() / forFamily() drive every filter flag; DeriveEventEmitter + NullDeriveEventSink are facts-only and opt-in."
      ]
    }
  ]
