{
    "name": "it-pack/configure-it-schema-docs",
    "description": "Emit Markdown reference docs + JSON-Schema from a Nette\\Schema\\Expect definition (ConfigureIt schema introspection).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "configuration",
        "schema",
        "docs",
        "json-schema",
        "nette",
        "introspection"
    ],
    "require": {
        "php": "^8.5",
        "it-pack/configure-it": "^1.1",
        "nette/schema": "^1.3"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.3",
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0",
        "just-bases/php-obs-dev-base": "^0.1.0",
        "infection/codeception-adapter": "^0.4",
        "symfony/http-client": "^8.1",
        "nyholm/psr7": "^1.8",
        "phparkitect/phparkitect": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\ConfigureItSchemaDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\ConfigureItSchemaDocs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse",
        "mutation": "vendor/bin/infection --configuration=infection.json5 --min-msi=80 --no-interaction",
        "security:audit": "@composer audit",
        "quality": [
            "@cs:check",
            "@analyse",
            "@architecture",
            "@test",
            "@mutation",
            "@security:audit"
        ],
        "architecture": "vendor/bin/phparkitect check"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "dantleech/what-changed": true,
            "tbachert/spi": false
        }
    }
}
