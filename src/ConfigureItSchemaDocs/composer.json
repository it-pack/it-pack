{
    "name": "it-pack/configure-it-schema-docs",
    "description": "Emit Markdown reference docs + JSON-Schema from a Nette\\Schema\\Expect definition (ConfigureIt schema introspection).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "configuration",
        "schema",
        "docs",
        "json-schema",
        "nette",
        "introspection"
    ],
    "require": {
        "php": "^8.3",
        "it-pack/configure-it": "*",
        "nette/schema": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\ConfigureItSchemaDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\ConfigureItSchemaDocs\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../ConfigureIt",
            "options": {
                "symlink": true
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
