<?xml version="1.0"?>
<ruleset name="ConfigureItRunit">
    <description>Line-length gate (120) for it-pack/configure-it-runit.</description>
    <arg name="colors"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
            <property name="ignoreComments" value="false"/>
        </properties>
    </rule>
</ruleset>
