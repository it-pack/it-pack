{
    "name": "it-pack/run-it-third-party-sample",
    "description": "Third-party reference adapter for RunIt — proves a consumer that depends on it-pack/run-it purely as a vendor can implement the ArtifactPublisherInterface and ContextStorageInterface ports and pass the shipped conformance suites.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "run-it",
        "third-party",
        "adapter",
        "conformance",
        "execution",
        "it-pack",
        "itpack"
    ],
    "require": {
        "php": "^8.4",
        "it-pack/run-it": "*@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "squizlabs/php_codesniffer": "*",
        "infection/infection": "*"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\RunItThirdPartySample\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\RunItThirdPartySample\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test:unit": "vendor/bin/phpunit",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "cs:lines": "vendor/bin/phpcs --standard=phpcs.xml.dist src tests",
        "analyse": "vendor/bin/phpstan analyse",
        "coverage": "vendor/bin/phpunit --coverage-text",
        "infection": "vendor/bin/infection --min-msi=80"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../RunIt"
        }
    ]
}
