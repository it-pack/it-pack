{
    "name": "it-pack/run-it-third-party-sample",
    "description": "Third-party reference adapter for RunIt \u2014 proves a consumer that depends on it-pack/run-it purely as a vendor can implement the ArtifactPublisherInterface and ContextStorageInterface ports and pass the shipped conformance suites.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "run-it",
        "third-party",
        "adapter",
        "conformance",
        "execution",
        "it-pack",
        "itpack"
    ],
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "require": {
        "php": "^8.4",
        "it-pack/run-it": "*@dev"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.3",
        "infection/codeception-adapter": "^0.4",
        "just-bases/php-obs-dev-base": "^0.1.0",
        "just-bases/php-qa-base": "^1.0",
        "just-bases/php-unit-test-base": "^1.0",
        "nyholm/psr7": "^1.8",
        "phparkitect/phparkitect": "^1.2",
        "symfony/http-client": "^8.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../RunIt"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "ItPack\\RunItThirdPartySample\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\RunItThirdPartySample\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dantleech/what-changed": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "architecture": "vendor/bin/phparkitect check",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "mutation": "vendor/bin/infection --configuration=infection.json5 --min-msi=80 --no-interaction",
        "quality": [
            "@cs:check",
            "@analyse",
            "@architecture",
            "@test",
            "@mutation",
            "@security:audit"
        ],
        "security:audit": "@composer audit",
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit"
    }
}
