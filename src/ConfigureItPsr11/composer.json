{
    "name": "it-pack/configure-it-psr11",
    "description": "PSR-11 container integration for ConfigureIt — exposes the resolved configuration snapshot through any PSR-11 compliant container.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "psr/container": "^2.0",
        "it-pack/configure-it": "*@dev"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.3",
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\ConfigureItPsr11\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\ConfigureItPsr11\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "dantleech/what-changed": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../ConfigureIt"
        }
    ]
}
