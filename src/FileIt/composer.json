{
    "name": "it-pack/file-it",
    "description": "Filesystem path resolution and file introspection utilities for ItPack packages.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "filesystem",
        "fileinfo",
        "introspection",
        "it-pack"
    ],
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.3",
        "infection/codeception-adapter": "^0.4",
        "just-bases/php-obs-dev-base": "^0.1.0",
        "just-bases/php-qa-base": "^1.0",
        "just-bases/php-unit-test-base": "^1.0",
        "nyholm/psr7": "^1.8",
        "phparkitect/phparkitect": "^1.2",
        "symfony/http-client": "^8.1"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "ItPack\\FileIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dantleech/what-changed": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "architecture": "vendor/bin/phparkitect check",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "mutation": "vendor/bin/infection --configuration=infection.json5 --min-msi=0 --no-interaction",
        "quality": [
            "@cs:check",
            "@analyse",
            "@architecture",
            "@test:unit",
            "@mutation",
            "@security:audit"
        ],
        "security:audit": "@composer audit",
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit"
    }
}
