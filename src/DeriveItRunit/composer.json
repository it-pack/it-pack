{
    "name": "it-pack/derive-it-runit",
    "description": "RunIt execution-model integration for DeriveIt — bridges derivation telemetry onto a RunIt execution so derivations appear as first-class executions.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "derive-it",
        "run-it",
        "execution",
        "telemetry",
        "integration",
        "it-pack",
        "itpack"
    ],
    "require": {
        "php": "^8.4",
        "it-pack/derive-it": "*@dev",
        "it-pack/run-it": "*@dev"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.3",
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\DeriveItRunit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItPack\\DeriveItRunit\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "dantleech/what-changed": true,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse",
        "coverage": "vendor/bin/phpunit --coverage-text",
        "infection": "vendor/bin/infection --min-msi=80"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../DeriveIt"
        },
        {
            "type": "path",
            "url": "../RunIt"
        }
    ]
}
