{
    "name": "it-pack/hash-it-async",
    "description": "Concurrent file hashing bridge: fans HashIt's hashFile across the AsyncIt runtime.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "it-pack/hash-it": "*^1.1",
        "it-pack/async-it": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "ItPack\\HashItAsync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "suggest": {
        "it-pack/hash-it": "The hashing core this bridge delegates to (hashFile).",
        "it-pack/async-it": "The async runtime this bridge fans work out across."
    },
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "require-dev": {
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0",
        "just-bases/php-obs-dev-base": "^0.1.0",
        "phparkitect/phparkitect": "^1.2",
        "infection/codeception-adapter": "^0.4",
        "symfony/http-client": "^8.1",
        "nyholm/psr7": "^1.8",
        "psr/http-message": "^2.0"
    },
    "scripts": {
        "test": "vendor/bin/codecept run",
        "test:unit": "vendor/bin/codecept run Unit",
        "coverage": "vendor/bin/codecept run Unit --coverage --coverage-xml --coverage-html",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse",
        "architecture": "vendor/bin/phparkitect check",
        "mutation": "vendor/bin/infection --min-msi=70 --no-interaction",
        "security:audit": "@composer audit",
        "quality": [
            "@cs:check",
            "@analyse",
            "@architecture",
            "@test:unit",
            "@mutation",
            "@security:audit"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "infection/extension-installer": true,
            "dantleech/what-changed": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": false
        }
    }
}
